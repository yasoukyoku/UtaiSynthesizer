// ── 历史记录结构 (Plan §4.5 SongHistoryEntry) ────────────────────────────

export interface SongHistoryEntry {
  /** 稳定 uuid — 历史记录的 identity key */
  uuid: string;
  /** 生成时选中的模型文件 */
  modelId: string;
  /** 模型家族, 决定参数面板渲染 */
  modelFamily: SongModelFamily;
  /** 许可证 — Plan §7 合规 */
  license: SongModelPreset["license"] | "unknown";
  /** 生成时的 settings 快照 — 恢复历史时可一键回填 */
  settings: SongGenParams;
  /** 产出物列表 (audio_path / midi_path / lrc_path) */
  outputs: SongOutput[];
  /** 轨道 id — 如果落轨成功, 可在主轨道区定位 */
  trackId?: string;
  /** 生成时间戳 ms */
  timestamp: number;
  /** 简短 label — 取歌词第一行或 prompt 截断 */
  label?: string;
}

// ── 左栏: ModelPicker (带许可证徽标) ────────────────────────────────────

interface ModelPickerProps {
  models: SongModelFile[];
  presets: SongModelPreset[];
  selected: string | null;
  onSelect: (filename: string, family: SongModelFamily) => void;
  downloading: { id: string; downloaded: number; total: number } | null;
  onDownload: (preset: SongModelPreset) => void;
}

function ModelPicker({ models, presets, selected, onSelect, downloading, onDownload }: ModelPickerProps) {
  const [showPresets, setShowPresets] = useState(false);
  return (
    <aside className="ss-col ss-left">
      <div className="ss-col-head">
        <span className="ss-col-title">{i18n.t("songStudio.models")}</span>
        <button className="ss-btn-ghost" onClick={() => setShowPresets((v) => !v)}>
          {showPresets ? i18n.t("common.close") : i18n.t("songStudio.downloadModel")}
        </button>
      </div>

      {showPresets && (
        <div className="ss-preset-list">
          {presets.map((p) => (
            <button
              key={p.id}
              className="ss-preset-item"
              onClick={() => onDownload(p)}
              disabled={downloading?.id === p.id}
              title={`${p.license} · ${formatBytes(p.sizeBytes)}`}
            >
              <span className="ss-preset-name">{p.label}</span>
              <span className="ss-license-badge">{p.license}</span>
            </button>
          ))}
        </div>
      )}

      <div className="ss-model-list">
        {models.length === 0 && !showPresets && (
          <div className="ss-empty-hint">{i18n.t("songStudio.noModels")}</div>
        )}
        {models.map((m) => {
          const pres = presets.find((p) => p.id === m.filename || p.filename === m.filename || p.label.toLowerCase().includes(m.filename.toLowerCase()));
          const fam = pres?.family ?? inferFamily(m.filename);
          const isDl = downloading?.id === m.filename;
          return (
            <button
              key={m.filename}
              className={`ss-model-item ${selected === m.filename ? "ss-active" : ""}`}
              onClick={() => onSelect(m.filename, fam)}
              title={pres?.license ?? "unknown"}
            >
              <div className="ss-model-row">
                <span className="ss-model-name">{m.filename}</span>
                {pres && <span className="ss-license-badge ss-license-mini">{pres.license}</span>}
              </div>
              <div className="ss-model-row">
                <span className="ss-model-size">{formatBytes(m.size)}</span>
                <span className="ss-family-tag">{fam.toUpperCase()}</span>
              </div>
              {isDl && downloading && (
                <div className="ss-progress-bar">
                  <div
                    className="ss-progress-fill"
                    style={{
                      width: downloading.total
                        ? `${(downloading.downloaded / downloading.total) * 100}%`
                        : "0%",
                    }}
                  />
                </div>
              )}
            </button>
          );
        })}
      </div>
    </aside>
  );
}

function inferFamily(filename: string): SongModelFamily {
  const lower = filename.toLowerCase();
  if (lower.includes("yue2") || lower.includes("yue-2") || lower.includes("mmap")) return "yue2";
  return "acestep";
}

function formatBytes(b: number): string {
  if (b < 1024) return `${b} B`;
  if (b < 1024 * 1024) return `${(b / 1024).toFixed(1)} KB`;
  if (b < 1024 * 1024 * 1024) return `${(b / (1024 * 1024)).toFixed(1)} MB`;
  return `${(b / (1024 * 1024 * 1024)).toFixed(2)} GB`;
}

// ── 中栏: 双模型参数面板 (YuE2 vs ACE-Step) ────────────────────────────

interface ParamsPanelProps {
  modelFamily: SongModelFamily;
  selectedModel: string | null;
  params: SongGenParams;
  setParams: (updates: Partial<SongGenParams>) => void;
  generating: boolean;
  progress: { stage: string; current: number; total: number; stem_label: string } | null;
  onGenerate: () => void;
  probeOk: boolean | null;
  onProbe: () => void;
}

function ParamsPanel({ modelFamily, selectedModel, params, setParams, generating, progress, onGenerate, probeOk, onProbe }: ParamsPanelProps) {
  const disabled = generating || !selectedModel || !params.service_url;
  return (
    <main className="ss-col ss-center">
      <div className="ss-col-head">
        <span className="ss-col-title">
          {i18n.t("songStudio.params")}{" "}
          <span className="ss-family-tag">{modelFamily.toUpperCase()}</span>
        </span>
      </div>

      <div className="ss-service-row">
        <input
          className="ss-input"
          placeholder={i18n.t("songStudio.serviceUrlPlaceholder")}
          value={params.service_url}
          onChange={(e) => setParams({ service_url: e.target.value.trim() })}
        />
        <button
          className={`ss-btn ss-btn-probe ${probeOk === true ? "ss-ok" : probeOk === false ? "ss-bad" : ""}`}
          onClick={onProbe}
          title={i18n.t("songStudio.probeService")}
        >
          {probeOk === null ? "◉" : probeOk ? "✓" : "✗"}
        </button>
      </div>

      <div className="ss-form">
        <label className="ss-field">
          <span className="ss-label">{i18n.t("songStudio.songName")}</span>
          <input
            className="ss-input"
            placeholder={i18n.t("songStudio.songName")}
            value={params.songName}
            onChange={(e) => setParams({ songName: e.target.value })}
          />
        </label>

        <label className="ss-field">
          <span className="ss-label">{i18n.t("songStudio.lyrics")}</span>
          <textarea
            className="ss-textarea"
            rows={5}
            placeholder={i18n.t("songStudio.lyricsPlaceholder")}
            value={params.lyrics}
            onChange={(e) => setParams({ lyrics: e.target.value })}
          />
        </label>

        <div className="ss-row">
          <label className="ss-field ss-field-half">
            <span className="ss-label">{i18n.t("songStudio.bpm")}</span>
            <input className="ss-input" type="number" min={40} max={240} value={params.bpm}
              onChange={(e) => setParams({ bpm: Number(e.target.value) })} />
          </label>
          <label className="ss-field ss-field-half">
            <span className="ss-label">{i18n.t("songStudio.timeSignature")}</span>
            <select className="ss-input" value={params.time_signature}
              onChange={(e) => setParams({ time_signature: e.target.value })}>
              <option>4/4</option><option>3/4</option><option>6/8</option><option>5/4</option>
            </select>
          </label>
        </div>

        <div className="ss-row">
          <label className="ss-field ss-field-half">
            <span className="ss-label">{i18n.t("songStudio.language")}</span>
            <select className="ss-input" value={params.language}
              onChange={(e) => setParams({ language: e.target.value })}>
              <option value="zh">{i18n.t("songStudio.langZh")}</option>
              <option value="en">{i18n.t("songStudio.langEn")}</option>
              <option value="ja">{i18n.t("songStudio.langJa")}</option>
              <option value="ko">{i18n.t("songStudio.langKo")}</option>
            </select>
          </label>
          <label className="ss-field ss-field-half">
            <span className="ss-label">{i18n.t("songStudio.durationSec")}</span>
            <input className="ss-input" type="number" min={10} max={300} step={5}
              value={params.audio_duration}
              onChange={(e) => setParams({ audio_duration: Number(e.target.value) })} />
          </label>
        </div>

        <label className="ss-field">
          <span className="ss-label">{i18n.t("songStudio.prompt")}</span>
          <input className="ss-input" placeholder={i18n.t("songStudio.promptPlaceholder")}
            value={params.prompt}
            onChange={(e) => setParams({ prompt: e.target.value })} />
        </label>

        {/* === YuE2 专属控件 === */}
        {modelFamily === "yue2" && (
          <>
            <div className="ss-subtitle">YuE2 Advanced</div>
            <div className="ss-row">
              <label className="ss-field ss-field-half">
                <span className="ss-label">vocal_gender</span>
                <select className="ss-input" value={params.vocal_gender ?? "auto"}
                  onChange={(e) => setParams({ vocal_gender: e.target.value })}>
                  <option value="auto">Auto</option>
                  <option value="female">Female</option>
                  <option value="male">Male</option>
                </select>
              </label>
              <label className="ss-field ss-field-half">
                <span className="ss-label">vocal_type</span>
                <select className="ss-input" value={params.vocal_type ?? "soprano"}
                  onChange={(e) => setParams({ vocal_type: e.target.value })}>
                  <option value="soprano">Soprano</option>
                  <option value="mezzo-soprano">Mezzo-soprano</option>
                  <option value="alto">Alto</option>
                  <option value="tenor">Tenor</option>
                  <option value="baritone">Baritone</option>
                  <option value="bass">Bass</option>
                </select>
              </label>
            </div>
            <label className="ss-field">
              <span className="ss-label">vocal_range</span>
              <input className="ss-input" placeholder="e.g. C4-C6"
                value={params.vocal_range ?? ""}
                onChange={(e) => setParams({ vocal_range: e.target.value })} />
            </label>
            <label className="ss-field">
              <span className="ss-label">cot (chain-of-thought)</span>
              <select className="ss-input" value={params.cot ?? "full"}
                onChange={(e) => setParams({ cot: e.target.value })}>
                <option value="full">full — melody + chords (original)</option>
                <option value="melody">melody — melody only (cover)</option>
                <option value="off">off — direct generation</option>
              </select>
            </label>
          </>
        )}

        {/* === ACE-Step 专属控件 === */}
        {modelFamily === "acestep" && (
          <>
            <div className="ss-subtitle">ACE-Step Advanced</div>
            <div className="ss-row">
              <label className="ss-field ss-field-half">
                <span className="ss-label">guidance_scale</span>
                <input className="ss-input" type="number" min={1} max={20} step={0.5}
                  value={params.guidance_scale ?? 7}
                  onChange={(e) => setParams({ guidance_scale: Number(e.target.value) })} />
              </label>
              <label className="ss-field ss-field-half">
                <span className="ss-label">shift</span>
                <input className="ss-input" type="number" min={-12} max={12} step={1}
                  value={params.shift ?? 0}
                  onChange={(e) => setParams({ shift: Number(e.target.value) })} />
              </label>
            </div>
            <div className="ss-row">
              <label className="ss-field ss-field-half">
                <span className="ss-label">cfg_scale</span>
                <input className="ss-input" type="number" min={1} max={20} step={0.5}
                  value={params.cfg_scale ?? 7}
                  onChange={(e) => setParams({ cfg_scale: Number(e.target.value) })} />
              </label>
              <label className="ss-field ss-field-half">
                <span className="ss-label">num_inference_steps</span>
                <input className="ss-input" type="number" min={10} max={100} step={1}
                  value={params.num_inference_steps ?? 50}
                  onChange={(e) => setParams({ num_inference_steps: Number(e.target.value) })} />
              </label>
            </div>
            <div className="ss-row">
              <label className="ss-field ss-field-half">
                <span className="ss-label">seed</span>
                <input className="ss-input" type="number"
                  value={params.seed ?? -1}
                  onChange={(e) => setParams({ seed: Number(e.target.value) })} />
              </label>
              <label className="ss-field ss-field-half">
                <span className="ss-label">format</span>
                <select className="ss-input" value={params.format ?? "mp3"}
                  onChange={(e) => setParams({ format: e.target.value })}>
                  <option>mp3</option><option>wav</option><option>flac</option><option>midi</option>
                </select>
              </label>
            </div>
          </>
        )}

        <div className="ss-check-row">
          <label>
            <input 
              type="checkbox" 
              checked={params.want_stems}
              disabled={modelFamily === "heartmula"}
              onChange={(e) => setParams({ want_stems: e.target.checked })} 
            />
            {i18n.t("songStudio.wantStems")}
            {modelFamily === "heartmula" && <span style={{color: "#999", marginLeft: "4px"}}>(不支持)</span>}
          </label>
          <label>
            <input 
              type="checkbox" 
              checked={params.want_midi}
              disabled={modelFamily === "heartmula"}
              onChange={(e) => setParams({ want_midi: e.target.checked })} 
            />
            {i18n.t("songStudio.wantMidi")}
            {modelFamily === "heartmula" && <span style={{color: "#999", marginLeft: "4px"}}>(不支持)</span>}
          </label>
          <label><input type="checkbox" checked={params.want_lrc}
            onChange={(e) => setParams({ want_lrc: e.target.checked })} />{i18n.t("songStudio.wantLrc")}</label>
        </div>
      </div>

      {generating && progress && (
        <div className="ss-progress">
          <div className="ss-progress-head">
            <span>{progress.stage}</span>
            <span>{progress.stem_label}</span>
          </div>
          <div className="ss-progress-bar">
            <div className="ss-progress-fill"
              style={{
                width: progress.total
                  ? `${(progress.current / progress.total) * 100}%`
                  : "30%",
              }}
            />
          </div>
        </div>
      )}

      <div className="ss-generate-row">
        <button className="ss-btn ss-btn-primary ss-btn-generate" disabled={disabled} onClick={onGenerate}>
          {generating ? i18n.t("songStudio.generating") : i18n.t("songStudio.generate")}
        </button>
      </div>
    </main>
