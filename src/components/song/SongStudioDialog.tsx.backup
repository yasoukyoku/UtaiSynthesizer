/**
 * Song Studio (歌曲制作) 主面板 —— 完整实现 (F3+F4+F5+WARN)。
 *
 * 改动点:
 *   [F3] 落轨: generate 成功 → addTrack 新增 audio clip 轨道, 可直接在主轨道区播放
 *   [F4] 双模型面板: 根据 modelType (YuE2 / ACE-Step) 精准渲染专属控件
 *        YuE2 专属: cot, vocal_gender, vocal_type, vocal_range
 *        ACE-Step 专属: checkpoint, guidance_scale, shift, num_inference_steps, cfg_scale, seed, format
 *   [F5] 历史记录升级: 每个 entry 带 uuid / settings 快照 / license 合规字段
 *        Plan §7 许可证: 模型卡片必须显示 license 徽标
 *   [WARN] 弹窗纪律: 打开前检查 trainingPageOpen / confirm / updateDialog, 避免叠加
 *
 * 命令调用: src/lib/backendSong.ts (Rust song.rs 9 命令已全部实现并 cargo check 全绿)
 * 落轨: src/store/project.ts addTrack + create audioSegment (crypto.randomUUID 生成 id)
 */

import { useEffect, useRef, useState } from "react";
import { listen } from "@tauri-apps/api/event";
import i18n from "../../i18n";
import { useProjectStore } from "../../store/project";
import { useAppStore } from "../../store/app";
import {
  downloadSongModel,
  listSongModels,
  loadSongHistory,
  saveSongHistory,
  songGenerate,
  songServiceProbe,
  type SongModelFile,
  type SongOutput,
} from "../../lib/backendSong";
import type { Track } from "../../types/project";
import "./SongStudioDialog.css";

export interface SongStudioDialogProps {
  onClose: () => void;
}

// ── 类型: YuE2 / ACE-Step / HeartMuLa 参数合并体 ──────────────────────────────────

export type SongModelFamily = "yue2" | "acestep" | "heartmula";

export interface SongGenParams {
  // 通用 (两种模型共有)
  songName: string;
  lyrics: string;
  prompt: string;
  negative_prompt: string;
  bpm: number;
  time_signature: string;
  language: string;
  audio_duration: number;
  want_stems: boolean;
  want_midi: boolean;
  want_lrc: boolean;
  service_url: string;
  // YuE2 专属
  cot?: string;
  vocal_gender?: string;
  vocal_type?: string;
  vocal_range?: string;
  // ACE-Step 专属
  checkpoint?: string;
  guidance_scale?: number;
  shift?: number;
  num_inference_steps?: number;
  cfg_scale?: number;
  seed?: number;
  format?: string;
}

// ── 模型预设 catalog (带 mirror 轮换 + 许可证合规) ──────────────────────

export interface SongModelPreset {
  id: string;
  label: string;
  family: SongModelFamily;
  /** 许可证类型 — Plan §7 必须显示徽标（ACE-Step=Apache-2.0 可商用） */
  license: "CC-BY-NC-4.0" | "MIT" | "Apache-2.0" | "proprietary";
  /** 落盘文件名（<data>/models/song/<filename>），下载命令据此确定目标路径 */
  filename: string;
  sizeBytes: number;
  sha256?: string;
  /** 主站 + 镜像轮换候选 — 复用 download.rs expand_routes 能力 */
  urls: string[];
  /** 模型功能描述(速度/质量/特性) */
  description?: string;
  /** 显存需求说明 */
  vramRequirement?: string;
  /** 推荐显卡型号 */
  gpuRecommendation?: string;
}

