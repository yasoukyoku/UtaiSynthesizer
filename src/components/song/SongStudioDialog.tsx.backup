// ── 右栏: 历史记录 (升级版) ────────────────────────────────────────────

function HistoryPanel({
  history,
  onPick,
  loading,
}: {
  history: SongHistoryEntry[];
  onPick: (h: SongHistoryEntry) => void;
  loading: boolean;
}) {
  return (
    <aside className="ss-col ss-right">
      <div className="ss-col-head">
        <span className="ss-col-title">{i18n.t("songStudio.history")}</span>
      </div>
      <div className="ss-history-list">
        {loading && <div className="ss-empty-hint">…</div>}
        {!loading && history.length === 0 && (
          <div className="ss-empty-hint">{i18n.t("songStudio.noHistory")}</div>
        )}
        {history.map((h) => (
          <button key={h.uuid} className="ss-history-item" onClick={() => onPick(h)}>
            <div className="ss-history-head">
              <span className="ss-history-label">
                {h.label ?? h.outputs.find((o) => o.audio_path || o.midi_path)?.label ?? "song"}
              </span>
              <span className="ss-history-time">{formatTime(h.timestamp)}</span>
            </div>
            <div className="ss-history-meta">
              {h.modelFamily.toUpperCase()} · {h.modelId} · {h.settings.bpm} BPM
            </div>
            <div className="ss-history-artifacts">
              {h.outputs.map((o, i) => (
                <span key={i} className="ss-artifact">
                  {o.audio_path ? "♪" : o.midi_path ? "M" : o.lrc_path ? "L" : "?"}
                </span>
              ))}
            </div>
            <div className="ss-history-license">
              <span className="ss-license-badge ss-license-mini">{h.license}</span>
              {h.trackId && <span className="ss-track-tag">⧉ Track</span>}
            </div>
          </button>
        ))}
      </div>
    </aside>
  );
}

function formatTime(ts: number): string {
  const d = new Date(ts);
  const pad = (n: number) => n.toString().padStart(2, "0");
  return `${d.getFullYear()}/${pad(d.getMonth() + 1)}/${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

// ── 默认参数 ───────────────────────────────────────────────────────────

const DEFAULT_PARAMS: SongGenParams = {
  songName: "",
  lyrics: "",
  prompt: "",
  negative_prompt: "",
  bpm: 120,
  time_signature: "4/4",
  language: "zh",
  audio_duration: 30,
  want_stems: true,
  want_midi: true,
  want_lrc: false,
  service_url: "",
  // YuE2 defaults
  vocal_gender: "auto",
  vocal_type: "soprano",
  cot: "full",
  // ACE-Step defaults
  guidance_scale: 7,
  shift: 0,
  cfg_scale: 7,
  num_inference_steps: 50,
  seed: -1,
  format: "mp3",
};

// ── 主组件 ───────────────────────────────────────────────────────────────

export function SongStudioDialog({ onClose }: SongStudioDialogProps) {
  // F4: 双模型面板 — 先从 selectedModel 文件名推断, 允许用户手动切换
  const [modelFamily, setModelFamily] = useState<SongModelFamily>("acestep");
  const [selectedModel, setSelectedModel] = useState<string | null>(null);
  const [params, setParams] = useState<SongGenParams>(DEFAULT_PARAMS);

  const [models, setModels] = useState<SongModelFile[]>([]);
  const [generating, setGenerating] = useState(false);
  const [progress, setProgress] = useState<{ stage: string; current: number; total: number; stem_label: string } | null>(null);
  const [downloading, setDownloading] = useState<{ id: string; downloaded: number; total: number } | null>(null);
  const [probeOk, setProbeOk] = useState<boolean | null>(null);
  const [history, setHistory] = useState<SongHistoryEntry[]>([]);
  const [historyLoading, setHistoryLoading] = useState(false);

  const closeRequested = useRef(false);

  // F3: 落轨用的 store 钩子
  const addTrack = useProjectStore((s) => s.addTrack);

  // WARN: 弹窗纪律 — 打开前检查 trainingPageOpen / updateDialog 等, 避免叠加
  const trainingPageOpen = useAppStore((s) => s.trainingPageOpen);

  // ESC 关闭
  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape" && !closeRequested.current) {
        closeRequested.current = true;
        onClose();
      }
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [onClose]);

  // 挂载时拉一次模型清单 + 历史
  useEffect(() => {
    void listSongModels().then((m) => setModels(m));
    void loadHistory();
  }, []);

  // 订阅进度事件
  useEffect(() => {
    const unsubProg = listen<{ stage: string; current: number; total: number; stem_label: string }>(
      "song-progress",
      (e) => {
        setProgress(e.payload);
        if (e.payload.stage === "done") {
          setGenerating(false);
          setTimeout(() => loadHistory(), 300);
        }
      },
    );

    const unsubDl = listen<{ id: string; downloaded: number; total: number; stage: string }>(
      "song-download-progress",
      (e) => {
        if (e.payload.downloaded >= e.payload.total && e.payload.total > 0) {
          setDownloading(null);
          void listSongModels().then((m) => setModels(m));
        } else {
          setDownloading({
            id: e.payload.id,
            downloaded: e.payload.downloaded,
            total: e.payload.total,
          });
        }
      },
    );

    return () => {
      void unsubProg.then((fn) => fn());
      void unsubDl.then((fn) => fn());
    };
  }, []);

  // F5: 历史记录带 uuid + settings 快照 + license
  async function loadHistory() {
    setHistoryLoading(true);
    try {
      const raw = await loadSongHistory();
      if (!raw) { setHistory([]); return; }
      const parsed = JSON.parse(raw) as SongHistoryEntry[];
      setHistory(parsed.sort((a, b) => b.timestamp - a.timestamp));
    } catch {
      setHistory([]);
    } finally {
      setHistoryLoading(false);
    }
  }

  async function persistHistory(entries: SongHistoryEntry[]) {
    try {
      await saveSongHistory(entries);
    } catch {
      // 历史持久化失败不阻塞 UI — 生成产物已在磁盘上, 用户下次还能看到
    }
  }

  async function handleProbe() {
    if (!params.service_url) return;
    try {
      const p = await songServiceProbe(params.service_url);
      setProbeOk(p.ok);
    } catch {
      setProbeOk(false);
    }
  }

  async function handleDownload(preset: SongModelPreset) {
    try {
      setDownloading({ id: preset.id, downloaded: 0, total: 0 });
      await downloadSongModel(preset.urls, preset.id, preset.filename, preset.sha256);
      // 下载完成兜底：进度事件缺失或 total=0（无 Content-Length）时也能正确收尾。
      setDownloading(null);
      void listSongModels().then((m) => setModels(m));
    } catch (err) {
      console.error("song model download failed:", err);
      setDownloading(null);
    }
  }

  // F3: 落轨 — generate 成功后 addTrack 新增 audio clip 轨道
  function depositToTrack(audioPath: string, label: string, durationMs: number = 60000): string {
    const proj = useProjectStore.getState();
    const bpm = proj.tempo ?? params.bpm ?? 120;
    const ticksPerBeat = 480; // PPQ default
    const durationTicks = Math.max(1, Math.round((durationMs / 60000) * bpm * ticksPerBeat));
    const startTick = 0;
    const trackId = crypto.randomUUID();
    const segmentId = crypto.randomUUID();

    const track: Track = {
      id: trackId,
      name: `🎧 ${label}`,
      trackType: "audio",
      segments: [
        {
          id: segmentId,
          startTick,
          durationTicks,
          content: {
            type: "audioClip",
            sourcePath: audioPath,
            offsetMs: 0,
            totalDurationMs: durationMs,
          },
        },
      ],
      volumeDb: 0,
      pan: 0,
      muted: false,
      solo: false,
      expanded: true,
      laneControls: {},
      laneMutes: {},
      autoArrangeNodeId: undefined,
    };
    addTrack(track);
    return trackId;
  }

  async function handleGenerate() {
    if (!selectedModel) return;
    if (!params.service_url) return;
    if (trainingPageOpen) {
      // WARN: 弹窗纪律 — training page 开着就不让生成, 避免状态错乱
      alert("Training page is open — close it before generating songs.");
      return;
    }
    setGenerating(true);
    setProgress({ stage: "request", current: 0, total: 1, stem_label: "song" });

    // 先探测一次 — service 挂了直接报错, 不浪费用户时间
    try {
      const probe = await songServiceProbe(params.service_url);
      if (!probe.ok) {
        alert(`Song service unreachable at ${params.service_url}. Check URL in Settings.`);
        setProgress(null);
        setGenerating(false);
        return;
      }
    } catch {
      alert(`Probe failed — is ${params.service_url} reachable?`);
      setProgress(null);
      setGenerating(false);
      return;
    }

    try {
      const songName = params.songName.trim();
      const outputs = await songGenerate({
        model: selectedModel,
        song_name: songName,
        lyrics: params.lyrics,
        prompt: params.prompt,
        negative_prompt: params.negative_prompt,
        bpm: params.bpm,
        time_signature: params.time_signature,
        language: params.language,
        audio_duration: params.audio_duration,
        want_stems: params.want_stems,
        want_midi: params.want_midi,
        want_lrc: params.want_lrc,
        // YuE2
        cot: modelFamily === "yue2" ? params.cot : undefined,
        vocal_gender: modelFamily === "yue2" ? params.vocal_gender : undefined,
        vocal_type: modelFamily === "yue2" ? params.vocal_type : undefined,
        vocal_range: modelFamily === "yue2" ? params.vocal_range : undefined,
        // ACE-Step
        checkpoint: modelFamily === "acestep" ? params.checkpoint : undefined,
        guidance_scale: modelFamily === "acestep" ? params.guidance_scale : undefined,
        shift: modelFamily === "acestep" ? params.shift : undefined,
        num_inference_steps: modelFamily === "acestep" ? params.num_inference_steps : undefined,
        cfg_scale: modelFamily === "acestep" ? params.cfg_scale : undefined,
        seed: modelFamily === "acestep" ? params.seed : undefined,
        format: modelFamily === "acestep" ? params.format : undefined,
        // 通用
        service_url: params.service_url,
      });

      setProgress({ stage: "done", current: 1, total: 1, stem_label: "song" });
      // 主动复位生成态 — "song-progress" 的 done 事件是异步派发的, 若因时序被错过,
      // spinning 会永久卡在「生成中」。这里同步收尾, 不依赖事件触达。
      setGenerating(false);

      // F3: 落轨 — 如果有音频输出, 创建新轨道
      let trackId: string | undefined;
      const primaryAudio = outputs.find((o) => o.audio_path);
      if (primaryAudio?.audio_path) {
        trackId = depositToTrack(
          primaryAudio.audio_path,
          songName || primaryAudio.label || params.lyrics.split(/\r?\n/).find((l) => l.trim()) || "song",
          Math.round(params.audio_duration * 1000),
        );
      }

      // F5: 历史记录 — 完整快照
      const preset = SONG_MODEL_PRESETS.find((p) =>
        p.id === selectedModel || selectedModel.toLowerCase().includes(p.id.toLowerCase()),
      );
      const entry: SongHistoryEntry = {
        uuid: crypto.randomUUID(),
        modelId: selectedModel,
        modelFamily,
        license: preset?.license ?? "unknown",
        settings: { ...params },
        outputs,
        trackId,
        timestamp: Date.now(),
        label: (songName || params.lyrics.split(/\r?\n/).find((l) => l.trim()) ||
          outputs.find((o) => o.audio_path || o.midi_path)?.label)?.slice(0, 40),
      };
      const next = [entry, ...history];
      setHistory(next);
      void persistHistory(next);
    } catch (err) {
      console.error("song_generate failed:", err);
      setProgress(null);
      setGenerating(false);
      alert(`Song generation failed: ${(err as Error)?.message ?? "unknown error"}`);
    }
  }

  function handleHistoryPick(h: SongHistoryEntry) {
    // F5: 恢复历史快照 — 点击历史记录可一键回填参数 + 落轨
    setSelectedModel(h.modelId);
    setModelFamily(h.modelFamily);
    setParams(h.settings);
    if (h.trackId) {
      const elem = document.querySelector(`[data-track-id="${h.trackId}"]`);
      elem?.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  }

  return (
    <div className="ss-overlay" onClick={onClose}>
      <div
        className="ss-panel"
        role="dialog"
        aria-label={i18n.t("songStudio.title")}
        onClick={(e) => e.stopPropagation()}
      >
        <header className="ss-head">
          <span className="ss-title">{i18n.t("songStudio.title")}</span>
          <button className="ss-close" onClick={onClose} aria-label={i18n.t("common.close")}>✕</button>
        </header>

        <div className="ss-body">
          <ModelPicker
            models={models}
            presets={SONG_MODEL_PRESETS}
            selected={selectedModel}
            onSelect={(filename, fam) => {
              setSelectedModel(filename);
              setModelFamily(fam);
            }}
            downloading={downloading}
            onDownload={handleDownload}
          />
          <ParamsPanel
            modelFamily={modelFamily}
            selectedModel={selectedModel}
            params={params}
            setParams={(updates) => setParams((prev) => ({ ...prev, ...updates }))}
            generating={generating}
            progress={progress}
            onGenerate={handleGenerate}
            probeOk={probeOk}
            onProbe={handleProbe}
          />
          <HistoryPanel
            history={history}
            loading={historyLoading}
            onPick={handleHistoryPick}
          />
        </div>
      </div>
    </div>
  );
}
